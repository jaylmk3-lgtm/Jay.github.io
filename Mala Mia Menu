<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mala Mia | Urban Kitchen & Bar</title>

<style>
:root{
--primary-pink:#e94e77;
--accent-yellow:#f1c40f;
--bg-cream:#f9f4e8;
--dark-text:#2c3e50;
--grafitti-purple:#8e44ad;
}

body{
font-family:'Segoe UI',Tahoma,Geneva,Verdana,sans-serif;
background-color:var(--bg-cream);
color:var(--dark-text);
margin:0;
line-height:1.6;
}

header{
background:#000;
color:#fff;
text-align:center;
padding:2rem 1rem;
border-bottom:5px solid var(--primary-pink);
}

.logo{
font-size:3rem;
font-weight:bold;
color:var(--primary-pink);
text-transform:uppercase;
letter-spacing:2px;
}

.hours{
font-size:.9rem;
color:var(--accent-yellow);
}

nav{
position:sticky;
top:0;
background:#fff;
padding:1rem;
text-align:center;
box-shadow:0 2px 5px rgba(0,0,0,.1);
z-index:1000;
}

nav a{
margin:0 10px;
text-decoration:none;
color:var(--dark-text);
font-weight:bold;
text-transform:uppercase;
font-size:.75rem;
}

.container{
max-width:1100px;
margin:auto;
padding:2rem;
}

.section-title{
font-size:2.3rem;
text-align:center;
margin-bottom:2rem;
color:var(--grafitti-purple);
text-transform:uppercase;
border-bottom:2px dashed #ccc;
padding-bottom:.5rem;
}

.menu-grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(300px,1fr));
gap:2rem;
margin-bottom:4rem;
}

.menu-item{
background:#fff;
border-radius:15px;
overflow:hidden;
box-shadow:0 4px 15px rgba(0,0,0,.05);
transition:.3s;
}

.menu-item:hover{transform:translateY(-5px);}

.image-box{
width:100%;
height:200px;
background:#ddd;
display:flex;
align-items:center;
justify-content:center;
color:#888;
font-style:italic;
background-size:cover;
background-position:center;
}

.content{padding:1.5rem;}

.header-row{
display:flex;
justify-content:space-between;
align-items:flex-start;
margin-bottom:.5rem;
}

.item-name{
font-size:1.2rem;
font-weight:bold;
color:var(--primary-pink);
}

.price{
font-weight:bold;
color:#27ae60;
background:#f0fff0;
padding:2px 8px;
border-radius:5px;
}

.description{
font-size:.9rem;
color:#666;
}

footer{
text-align:center;
padding:3rem;
background:#222;
color:#888;
font-size:.8rem;
}

@media(max-width:600px){
.menu-grid{grid-template-columns:1fr;}
}
</style>
</head>

<body>

<header>
<div class="logo">Mala Mia</div>
<div class="hours">M-V: 4:00 PM – 12:00 AM | S-D: 12:00 PM – 12:00 AM</div>
</header>

<nav>
<a href="#entradas">Pa’ Empezar</a>
<a href="#fries">Las Fries</a>
<a href="#fit">Pa’ los Fit</a>
<a href="#mex">Mexicana</a>
<a href="#meat">Meat Lovers</a>
<a href="#burgers">Burgers</a>
<a href="#chef">Chef</a>
<a href="#pasta">Pastas</a>
<a href="#dessert">Postres</a>
<a href="#drinks">Drinks</a>
</nav>

